{
  "name": "property-scraper",
  "version": "0.1.0",
  "private": true,
  "description": "Property scraping API built with Fastify and TypeScript",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest:gurs": "tsx src/gurs/cli.ts",
    "migrate:generate": "node node_modules/@izumisy/kyrage/dist/main.mjs generate",
    "migrate:plan": "node node_modules/@izumisy/kyrage/dist/main.mjs apply --plan",
    "migrate:apply": "node node_modules/@izumisy/kyrage/dist/main.mjs apply && tsx src/db/migrate.ts",
    "migrate:sql": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@izumisy/kyrage": "^1.6.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
